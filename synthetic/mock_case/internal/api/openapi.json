{
  "openapi": "3.1.0",
  "info": {
    "title": "mock-case: synthetic case system (case API)",
    "version": "1.0.0",
    "description": "SYNTHETIC test double for an enterprise case system (REQ-ENV-008, PERD §34.4). Runtime credential only. It offers cases, complaint references and append-only evidence, and nothing else: there is no operation to close or resolve a case, downgrade priority, change an SLA or clock, or edit or delete evidence, and no money movement."
  },
  "security": [
    {
      "bearer": []
    }
  ],
