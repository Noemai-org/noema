  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Case": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "ROUTED"
            ],
            "description": "OPEN when created; ROUTED after a successful route. There is no other status and no way back to OPEN: nothing closes or resolves a case."
          },
          "owner_queue": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "version_token": {
            "type": "string",
            "description": "Opaque. Compare it; do not parse it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "tenant_id": {
            "type": "string"
          },
          "principal_id": {
            "type": "string"
          },
          "transaction_ref": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "created_by_intent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
            "description": "The intent that created the case (the pack's fin.case created_by_intent, SoT 15.3). Fixed for life."
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The logical resolution epoch the case belongs to (PERD section 29). Fixed for life."
          }
        },
        "required": [
          "case_id",
          "reference",
          "status",
          "owner_queue",
          "priority",
          "idempotency_key",
          "version_token",
          "created_at",
          "tenant_id",
          "principal_id",
          "transaction_ref",
          "reason_code",
          "created_by_intent",
          "epoch"
        ]
      },
      "Complaint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "complaint_ref": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "logged_at": {
            "type": "string",
            "format": "date-time"
          },
          "clock_started_at": {
            "type": "string",
            "format": "date-time",
            "description": "SYNTHETIC regulatory clock; no operation changes it"
          },
          "tenant_id": {
            "type": "string"
          }
        },
        "required": [
          "complaint_ref",
          "case_id",
          "idempotency_key",
          "logged_at",
          "clock_started_at",
          "tenant_id"
        ]
      },
      "Attachment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attachment_id": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 of the exact bytes of payload"
          },
          "idempotency_key": {
            "type": "string"
          },
          "attached_at": {
            "type": "string",
            "format": "date-time"
          },
          "tenant_id": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          }
        },
        "required": [
          "attachment_id",
          "case_id",
          "payload_hash",
          "idempotency_key",
          "attached_at",
          "tenant_id",
          "payload"
        ]
      },
      "CasePage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Case"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "true when no more items remain"
          },
          "next_cursor": {
            "type": "string",
            "description": "present exactly when complete is false"
          }
        },
        "required": [
          "items",
          "complete"
        ]
      },
      "ComplaintPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Complaint"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "true when no more items remain"
          },
          "next_cursor": {
            "type": "string",
            "description": "present exactly when complete is false"
          }
        },
        "required": [
          "items",
          "complete"
        ]
      },
      "AttachmentPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "true when no more items remain"
          },
          "next_cursor": {
            "type": "string",
            "description": "present exactly when complete is false"
          }
        },
        "required": [
          "items",
          "complete"
        ]
      },
      "CreateCaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "principal_id": {
            "type": "string"
          },
          "transaction_ref": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "owner_queue": {
            "type": "string",
            "description": "SYNTHETIC queue; default PAYMENTS_OPERATIONS"
          },
          "priority": {
            "type": "string",
            "description": "SYNTHETIC priority; default NORMAL"
          },
          "created_by_intent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
            "description": "The intent that created the case (the pack's fin.case created_by_intent, SoT 15.3). Fixed for life."
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The logical resolution epoch the case belongs to (PERD section 29). Fixed for life."
          }
        },
        "required": [
          "tenant_id",
          "principal_id",
          "transaction_ref",
          "reason_code",
          "created_by_intent",
          "epoch"
        ]
      },
      "RouteCaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "owner_queue": {
            "type": "string"
          },
          "expected_version_token": {
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "owner_queue",
          "expected_version_token"
        ]
      },
      "CreateComplaintRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string"
          }
        },
        "required": [
          "tenant_id"
        ]
      },
      "AppendEvidenceRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "tenant_id",
          "payload"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "correlation_id": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "issue": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "issue"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
