      "get": {
        "operationId": "health",
        "summary": "Liveness and database reachability. The one path that needs no credential.",
        "responses": {
          "200": {
            "description": "ok"
          },
          "503": {
            "description": "UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
