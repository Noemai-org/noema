{
  "pack_id": "bad_08_cyclic_action_graph",
  "name": "Noema Fintech Pack v1",
  "domain": "FINTECH",
  "version": "fintech@1.0.0",
  "policy": {
    "policy_id": "fin.pol",
    "policy_version": "fin.pol@3.1",
    "precedence_ladder": [
      "LEGAL_REGULATORY",
      "SECURITY_FRAUD",
      "CORE_INTEGRITY",
      "BUSINESS_RULES",
      "USER_PREFERENCE"
    ],
    "default_action": "DENY",
    "max_dispute_amount_kobo": 500000000,
    "rules": [
      {
        "id": "rule_dedupe_cases",
        "description": "Never open a duplicate case for the same transaction in the same epoch",
        "enforcement": "STRICT"
      },
      {
        "id": "rule_routing_allowlist",
        "description": "Escalation queues must strictly belong to the routing allowlist",
        "enforcement": "STRICT"
      },
      {
        "id": "rule_revalidation_required",
        "description": "Pre-write revalidation of subject resource status is mandatory",
        "enforcement": "STRICT"
      }
    ]
  },
  "trust_profiles": {
    "default": {
      "profile_id": "tp_fintech_default",
      "max_evidence_age_seconds": 300,
      "freshness_sla_seconds": 300,
      "confidence_threshold": 0.85,
      "requires_confirmation_on_r3": true
    },
    "escalated": {
      "profile_id": "tp_fintech_escalated",
      "max_evidence_age_seconds": 60,
      "freshness_sla_seconds": 60,
      "confidence_threshold": 0.95,
      "requires_confirmation_on_r3": true
    }
  },
  "intent_classes": {
    "TRANSFER_FUNDS": {
      "intent_type": "TRANSFER_FUNDS",
      "read_write_class": "WRITE",
      "description": "The Actor wants to move funds from one financial resource to another (Prohibited in POC).",
      "required_slots": [
        "source_account",
        "destination_account",
        "amount",
        "currency"
      ],
      "allowed_outcomes": []
    },
    "VERIFY_TRANSACTION": {
      "intent_type": "VERIFY_TRANSACTION",
      "read_write_class": "READ",
      "description": "The Actor wants to establish whether a transaction occurred or has a particular status.",
      "required_slots": [
        "transaction_id"
      ],
      "allowed_outcomes": [
        "fin.outcome.transaction.verified"
      ]
    },
    "DISPUTE_TRANSACTION": {
      "intent_type": "DISPUTE_TRANSACTION",
      "read_write_class": "GOVERNANCE",
      "description": "The Actor wants to challenge a transaction.",
      "required_slots": [
        "transaction_id",
        "dispute_reason"
      ],
      "allowed_outcomes": [
        "fin.outcome.exception.case_opened"
      ]
    },
    "RECOVER_FUNDS": {
      "intent_type": "RECOVER_FUNDS",
      "read_write_class": "WRITE",
      "description": "The Actor wants funds recovered after a financial problem.",
      "required_slots": [
        "transaction_id"
      ],
      "allowed_outcomes": [
        "fin.outcome.exception.case_opened"
      ]
    },
    "VIEW_PAYMENT_STATUS": {
      "intent_type": "VIEW_PAYMENT_STATUS",
      "read_write_class": "READ",
      "description": "The Actor wants to view the status of a payment.",
      "required_slots": [
        "payment_reference"
      ],
      "allowed_outcomes": [
        "fin.outcome.transaction.verified"
      ]
    },
    "VIEW_TRANSFER_STATUS": {
      "intent_type": "VIEW_TRANSFER_STATUS",
      "read_write_class": "READ",
      "description": "The Actor wants to view the status of a transfer.",
      "required_slots": [
        "transfer_reference"
      ],
      "allowed_outcomes": [
        "fin.outcome.transaction.verified"
      ]
    },
    "SELECT_BENEFICIARY": {
      "intent_type": "SELECT_BENEFICIARY",
      "read_write_class": "READ",
      "description": "The Actor wants to select or resolve a beneficiary.",
      "required_slots": [
        "beneficiary_identifier"
      ],
      "allowed_outcomes": [
        "fin.outcome.transaction.verified"
      ]
    },
    "REQUEST_REFUND": {
      "intent_type": "REQUEST_REFUND",
      "read_write_class": "WRITE",
      "description": "The Actor requests a refund (routed via escalation case).",
      "required_slots": [
        "transaction_id",
        "refund_reason"
      ],
      "allowed_outcomes": [
        "fin.outcome.exception.case_opened"
      ]
    },
    "REPORT_UNAUTHORIZED_TRANSACTION": {
      "intent_type": "REPORT_UNAUTHORIZED_TRANSACTION",
      "read_write_class": "GOVERNANCE",
      "description": "The Actor reports an unauthorized transaction.",
      "required_slots": [
        "transaction_id"
      ],
      "allowed_outcomes": [
        "fin.outcome.exception.case_opened",
        "fin.outcome.complaint.logged"
      ]
    },
    "INVESTIGATE_EXCEPTION": {
      "intent_type": "INVESTIGATE_EXCEPTION",
      "read_write_class": "READ",
      "description": "The Actor wants to investigate a transaction exception.",
      "required_slots": [
        "account_number"
      ],
      "allowed_outcomes": [
        "fin.outcome.transaction.verified",
        "fin.outcome.exception.case_opened"
      ]
    }
  },
