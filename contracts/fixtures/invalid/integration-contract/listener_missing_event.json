{
  "schema_version": "1.0",
  "partner": "fin",
  "obligations": [
    "EMBED_OVERLAY",
    "RUN_LISTENER",
    "ISSUE_SCOPED_CREDENTIALS"
  ],
  "overlay": {
    "passes_existing_session_token": true,
    "sandboxed_context": true
  },
  "listener": {
    "signature_header": "Noema-Signature",
    "deduplicates_by": "event_id",
    "signed_events": [
      "confirmation.recorded",
      "case.created"
    ]
  },
  "signature": {
    "algorithm": "HMAC-SHA-256",
    "signed_payload": "timestamp, a dot, then the body",
    "delivery": "AT_LEAST_ONCE"
  },
  "credentials": [
    {
      "kind": "READ",
      "sources": [
        "fin.src.core_ledger",
        "fin.src.switch",
        "fin.src.settlement",
        "fin.src.beneficiary",
        "fin.src.case_system"
      ],
      "scoped_per_request_to_authenticated_customer": true
    },
    {
      "kind": "CASE_MANAGEMENT",
      "allowed_capabilities": [
        "fin.cap.create_escalation_case",
        "fin.cap.route_to_internal_owner",
        "fin.cap.log_complaint_reference",
        "fin.cap.record_investigation_evidence"
      ],
      "can_move_money": false
    }
  ],
  "resolution_message": "noema.resolution"
}
