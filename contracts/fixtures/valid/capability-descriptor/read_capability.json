{
  "capability_id": "fin.cap.lookup_transaction",
  "business_meaning": "SYNTHETIC test capability fin.cap.lookup_transaction",
  "input_schema": "schemas/fin/lookup_transaction.v1.json",
  "preconditions": [
    "subject_resource.status == RESOLVED"
  ],
  "authority": {
    "principal_must_own": [
      "subject_resource"
    ],
    "roles_allowed": [
      "customer",
      "ops_agent"
    ]
  },
  "policy_templates": [
    "fin.pol.case.dedupe"
  ],
  "risk_class": "R0_read",
  "side_effect_class": "NONE",
  "blast_radius": "one record for one principal",
  "idempotency": {
    "key_fields": [
      "tenant_id",
      "principal_id",
      "logical_action"
    ],
    "lookup": "case_system.find_by_idempotency_key"
  },
  "retry_safety": "NONE",
  "concurrency_control": "NONE",
  "revalidation_reads": [
    "subject_resource.status"
  ],
  "consequence_profile": {
    "financial": "NONE",
    "customer": "NONE",
    "regulatory": "NONE",
    "access": "NONE",
    "operational": "NONE",
    "irreversibility": "REVERSIBLE"
  },
  "expected_outcome": "fin.outcome.exception.case_opened",
  "verification": {
    "method": "independent_read",
    "source": "fin.src.case_system"
  },
  "retry": {
    "reads": "bounded_backoff",
    "writes": "only_under_new_grant_after_verification"
  },
  "recovery": [],
  "compensation": "not_applicable",
  "audit": [
    "EVIDENCE_READ"
  ],
  "limits": {
    "rate_per_principal_per_hour": 5,
    "timeout_ms": 3000,
    "circuit_breaker": {
      "error_rate": 0.5,
      "window_s": 60
    }
  },
  "prohibited": false
}
