   },
   "planned_queue": {
    "type": "Reference"
   },
   "evidence_packet_hash": {
    "type": "String"
   }
  }
 },
 "cases": [
  {
   "id": "true_literal",
   "expr": "true",
   "result": "Boolean"
  },
  {
   "id": "sot_case_opened",
   "expr": "exists(case where case.subject == subject_resource and case.status in ['OPEN','ROUTED']) and count(case where case.subject == subject_resource and case.created_by_intent == intent_id) == 1",
   "result": "Boolean"
  },
  {
   "id": "slot_status",
   "expr": "subject_resource.status == 'RESOLVED'",
   "result": "Boolean"
  },
  {
   "id": "not_exists",
   "expr": "not exists(case where case.subject == subject_resource and case.epoch == epoch)",
   "result": "Boolean"
  },
  {
   "id": "not_in",
   "expr": "not exists(case where case.status not in ['CLOSED'])",
   "result": "Boolean"
  },
  {
   "id": "or_and_precedence",
   "expr": "true or false and false",
   "result": "Boolean"
  },
  {
   "id": "parentheses",
   "expr": "(true or false) and true",
   "result": "Boolean"
  },
  {
   "id": "count_compare",
   "expr": "count(case where case.escalated == true) >= 1",
   "result": "Boolean"
  },
  {
   "id": "integer_arithmetic",
   "expr": "count(case where true) + 1 == 2",
   "result": "Boolean"
  },
  {
   "id": "timestamp_minus_duration",
   "expr": "exists(case where case.created_at > now() - 72h)",
   "result": "Boolean"
  },
  {
   "id": "timestamp_difference",
   "expr": "exists(case where now() - case.created_at > settle_window)",
   "result": "Boolean"
  },
  {
   "id": "duration_literals",
   "expr": "settle_window == 30s or settle_window == 2m or settle_window == 1h or settle_window == 1d",
   "result": "Boolean"
  },
  {
   "id": "null_test",
