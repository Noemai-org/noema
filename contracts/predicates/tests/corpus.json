      "type": "String"
     },
     "escalated": {
      "type": "Boolean"
     }
    }
   },
   {
    "entity": "attachment",
    "source": "fin.src.case_system",
    "fields": {
     "case": {
      "type": "Reference"
     },
     "payload_hash": {
      "type": "String"
     }
    }
   }
  ],
  "predicate_variables": {
