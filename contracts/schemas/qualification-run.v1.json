{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/qualification-run.v1.json",
  "title": "Qualification run record (v1)",
  "description": "UND-13, REQ-INT-006 (model-drift canary; DEC-2026-10-31 D25). What the canary in the model service emits: a new pinned provider version's structured answers to the qualification subset, compared case by case with the pinned baseline (the previously qualified version's recorded answers, never the oracle's expectation). GENERATED cases only: held-out and partner cases never reach it (INV-22). `result` is DRIFT if any case drifted (a different slot value, a missing or extra slot, or a provider that answered under another version than the one asked for), else PROVIDER_UNAVAILABLE if any case got no answer, else PASS. `differing_slots[].expected` is absent when the baseline had no such slot and `observed` is absent when the new answer had none. A PASS here is not a qualification: that is the qualification record. The reference implementation is benchmark/qualification/run.py. SYNTHETIC cases (AGENT-25).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "qualification-run.v1"
    },
    "subset_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "const": "GENERATED"
    },
    "n_cases": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cases_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "pinned": {
      "$ref": "#/$defs/Pinned"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "pinned": {
          "$ref": "#/$defs/Pinned"
        },
        "commit_sha": {
          "$ref": "#/$defs/CommitSha"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "pinned",
        "commit_sha",
        "sha256"
      ],
      "additionalProperties": false
    },
    "commit_sha": {
      "$ref": "#/$defs/CommitSha"
    },
    "recorded_on": {
      "$ref": "#/$defs/IsoDate"
    },
    "answered_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "DRIFT",
        "PROVIDER_UNAVAILABLE"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Case"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "subset_id",
    "layer",
    "n_cases",
    "cases_sha256",
    "pinned",
    "baseline",
    "commit_sha",
    "recorded_on",
    "answered_versions",
    "result",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "IsoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Pinned": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "llm",
            "speech"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "provider",
        "model_id",
        "version"
      ],
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "MATCH",
            "DRIFT",
            "UNAVAILABLE"
          ]
        },
        "answered_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_mismatch": {
          "type": "boolean"
        },
        "differing_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DifferingSlot"
          }
        },
        "expected_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "observed_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Sha256"
            }
          ]
        }
      },
      "required": [
        "case_id",
        "status",
        "answered_by",
        "version_mismatch",
        "differing_slots",
        "expected_sha256",
        "observed_sha256"
      ],
      "additionalProperties": false
    },
    "DifferingSlot": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "expected": {},
        "observed": {}
      },
      "required": [
        "slot"
      ],
      "additionalProperties": false
    }
  }
}
