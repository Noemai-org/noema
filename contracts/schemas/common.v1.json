{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/common.v1.json",
  "title": "Common definitions",
  "description": "Shared patterns for contract v1. SoT §43 (all objects carry schema_version, tenant_id, correlation_id), PERD §32.3 (IDs are <prefix>_<ULID>).",
  "$defs": {
    "SchemaVersion": {
      "description": "Semantic version of the contract, major.minor.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "Semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "Hash": {
      "description": "sha256: followed by 64 lower-case hex characters (PERD §21.3 step 2).",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Id": {
      "description": "<prefix>_<body>. PERD §32.3 makes the body a ULID. The SoT examples (int_01J9X3, dec_7Q2) are illustrative and shorter, so the wire contract accepts 2 to 32 alphanumerics; ULID generation is the ID generator's job.",
      "type": "string",
      "pattern": "^[a-z]{2,6}_[0-9A-Za-z]{2,32}$"
    },
    "Sig": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "additionalProperties": false,
      "description": "Key ID plus signature (SoT §43). HMAC-SHA-256 in the POC."
    },
    "PackId": {
      "description": "Namespaced ID in a pack: <vertical>.<segment>(.<segment>)*, all lower-case.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "Vertical": {
      "description": "The short namespace prefix of a pack, for example fin.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "SlotName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Predicate": {
      "description": "An expression in the SoT §43.7 predicate language. Parsing and type-checking happen at pack load (packcheck), not here.",
      "type": "string",
      "minLength": 1
    },
    "RequestId": {
      "type": "string",
      "pattern": "^req_[0-9A-Za-z]{2,32}$",
      "description": "Client-supplied request ID (a UUID in the canonical input, see CanonicalInput)."
    },
    "CorrelationId": {
      "type": "string",
      "pattern": "^corr_[0-9A-Za-z]{2,32}$"
    },
    "TenantId": {
      "type": "string",
      "pattern": "^ten_[0-9A-Za-z]{2,32}$"
    },
    "SessionId": {
      "type": "string",
      "pattern": "^ses_[0-9A-Za-z]{2,32}$"
    },
    "InvestigationId": {
      "type": "string",
      "pattern": "^inv_[0-9A-Za-z]{2,32}$"
    },
    "IntentId": {
      "type": "string",
      "pattern": "^int_[0-9A-Za-z]{2,32}$"
    },
    "CandidateSetId": {
      "type": "string",
      "pattern": "^cns_[0-9A-Za-z]{2,32}$"
    },
    "ClarificationId": {
      "type": "string",
      "pattern": "^clr_[0-9A-Za-z]{2,32}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^evr_[0-9A-Za-z]{2,32}$",
      "description": "Evidence item ID."
    },
    "SnapshotId": {
      "type": "string",
      "pattern": "^evs_[0-9A-Za-z]{2,32}$",
      "description": "Sealed context snapshot ID."
    },
    "ReconciliationId": {
      "type": "string",
      "pattern": "^rec_[0-9A-Za-z]{2,32}$",
      "description": "State reconciliation result ID."
    },
    "DecisionId": {
      "type": "string",
      "pattern": "^dec_[0-9A-Za-z]{2,32}$"
    },
    "ConfirmationRequestId": {
      "type": "string",
      "pattern": "^cfr_[0-9A-Za-z]{2,32}$"
    },
    "ConfirmationEventId": {
      "type": "string",
      "pattern": "^cfe_[0-9A-Za-z]{2,32}$"
    },
    "PlanId": {
      "type": "string",
      "pattern": "^pln_[0-9A-Za-z]{2,32}$"
    },
    "GrantId": {
      "type": "string",
      "pattern": "^grt_[0-9A-Za-z]{2,32}$"
    },
    "IdempotencyKeyId": {
      "type": "string",
      "pattern": "^idk_[0-9A-Za-z]{2,32}$"
    },
    "ReceiptId": {
      "type": "string",
      "pattern": "^rcp_[0-9A-Za-z]{2,32}$"
    },
    "VerdictId": {
      "type": "string",
      "pattern": "^ver_[0-9A-Za-z]{2,32}$"
    },
    "WatchId": {
      "type": "string",
      "pattern": "^wat_[0-9A-Za-z]{2,32}$"
    },
    "RecoveryRequestId": {
      "type": "string",
      "pattern": "^rrq_[0-9A-Za-z]{2,32}$"
    },
    "ExplanationId": {
      "type": "string",
      "pattern": "^exp_[0-9A-Za-z]{2,32}$"
    },
    "OutcomeEventId": {
      "type": "string",
      "pattern": "^evt_[0-9A-Za-z]{2,32}$",
      "description": "ID of an outcome.updated event."
    },
    "RecordEventId": {
      "type": "string",
      "pattern": "^recev_[0-9A-Za-z]{2,32}$",
      "description": "Record event ID. PERD §32.3 uses recev; the SoT §43.6 example shows rec_1001, which collides with the reconciliation prefix."
    },
    "MemoryId": {
      "type": "string",
      "pattern": "^mem_[0-9A-Za-z]{2,32}$"
    },
    "PrincipalId": {
      "type": "string",
      "pattern": "^usr_[0-9A-Za-z]{2,32}$",
      "description": "Principal ID as asserted by the enterprise IdP session (SoT §43.1 example: usr_88213)."
    },
    "IntentRef": {
      "description": "intent_id@version, the 'supersedes' link (PERD §20.1).",
      "type": "string",
      "pattern": "^int_[0-9A-Za-z]{2,32}@[0-9]+$"
    },
    "ResourceRef": {
      "description": "A pack resource reference, <vertical>.<kind>:<id> (for example fin.transaction:TX88213).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*:[A-Za-z0-9_.-]{1,64}$"
    },
    "Ratio": {
      "description": "A confidence or ratio in [0, 1]. Never money.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
