{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/explanation-facts.v2.json",
  "title": "Explanation facts",
  "description": "PERD §31.2 as amended by ruling A18 (6 Nov 2026): the only input to the customer renderer. Masked facts only; no policy, thresholds or raw evidence (REQ-EXP-001). v2 replaces the input list `template_ids` with the pair that selects a template, `outcome_id` and `classification` (templates are keyed by outcome class and locale; the template ID is an output of the renderer), and adds a nullable `voice.audio_ref` for the audio of a spoken answer (defined by Core Engineer 2 under A18; null when no audio exists). Facts come only from KNOWN and INFERRED evidence (INFERRED names its rule) and from verdicts; anything else is an unknown. Explanation output is never consumed by trust, execution or outcome code (AGENT-05).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SchemaVersion"
    },
    "correlation_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/CorrelationId"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en-NG",
        "pcm",
        "yo",
        "ha",
        "ig"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "fact_status": {
            "type": "string",
            "enum": [
              "KNOWN",
              "INFERRED"
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "value_masked": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?![\\s\\S]*[0-9]{5})[\\s\\S]*$"
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Timestamp"
          }
        },
        "required": [
          "fact_id",
          "kind",
          "fact_status",
          "value_masked",
          "source_label",
          "as_of"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "fact_status": {
              "const": "INFERRED"
            }
          }
        },
        "then": {
          "required": [
            "rule_id"
          ]
        },
        "else": {
          "not": {
            "required": [
              "rule_id"
            ]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "status": {
            "allOf": [
              {
                "$ref": "https://contracts.noema.invalid/enums.v1.json#/$defs/FactStatus"
              },
              {
                "not": {
                  "const": "KNOWN"
                }
              }
            ]
          },
          "why_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "required": [
          "fact_id",
          "kind",
          "status",
          "why_code"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability_label": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "$ref": "https://contracts.noema.invalid/enums.v1.json#/$defs/Verdict"
          },
          "case_ref_masked": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[0-9]{5})[\\s\\S]*$"
          }
        },
        "required": [
          "capability_label",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "advice": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "until": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Timestamp"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "outcome_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PackId"
    },
    "classification": {
      "description": "The reconciliation classification the answer is about, as the pack names it (for example SUCCESS_CONFIRMED). With outcome_id it selects the template.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "voice": {
      "description": "Audio of the spoken answer, if the channel is voice. audio_ref is a reference to stored audio and is null when none exists. Never raw audio (AGENT-13).",
      "type": "object",
      "properties": {
        "audio_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]+_[A-Za-z0-9_]{2,64}$"
        }
      },
      "required": [
        "audio_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "correlation_id",
    "locale",
    "facts",
    "unknowns",
    "actions",
    "advice",
    "next_steps",
    "outcome_id",
    "classification"
  ],
  "additionalProperties": false
}
