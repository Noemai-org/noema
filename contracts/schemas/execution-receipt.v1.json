{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/execution-receipt.v1.json",
  "title": "Execution Receipt",
  "description": "SoT §43.3 and PERD §27. Produced by Execution; it never writes SUCCEEDED (that word belongs to Outcome). A timeout or silence is OUTCOME_UNKNOWN with no acknowledgement; an ACKNOWLEDGED receipt carries the target's acknowledgement. A retry keeps idempotency_key and increments attempt, under a new grant (AGENT-08).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SchemaVersion"
    },
    "tenant_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
    },
    "correlation_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/CorrelationId"
    },
    "receipt_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/ReceiptId"
    },
    "grant_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/GrantId"
    },
    "idempotency_key": {
      "description": "idk_v1_ plus 64 lower-case hex (PERD §27.2). This is the form computed by contracts/fixtures/golden_vectors.json (checked by tools/contracts/test_gap_closure.py); SoT v1.9 shows the same form.",
      "type": "string",
      "pattern": "^idk_v1_[0-9a-f]{64}$"
    },
    "logical_action": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PackId"
    },
    "attempt": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PositiveInt"
    },
    "dispatched_at": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Timestamp"
    },
    "transport_result": {
      "description": "For example TIMEOUT. No value set is defined (state-registry §4), so only the shape is fixed.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_ack": {
      "description": "The target's acknowledgement reference, or null.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_state": {
      "$ref": "https://contracts.noema.invalid/enums.v1.json#/$defs/ExecutionState"
    },
    "sig": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Sig"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "correlation_id",
    "receipt_id",
    "grant_id",
    "idempotency_key",
    "logical_action",
    "attempt",
    "dispatched_at",
    "transport_result",
    "external_ack",
    "execution_state",
    "sig"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_state": {
            "const": "ACKNOWLEDGED"
          }
        }
      },
      "then": {
        "properties": {
          "external_ack": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "const": "OUTCOME_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "external_ack": {
            "type": "null"
          }
        }
      }
    }
  ]
}
