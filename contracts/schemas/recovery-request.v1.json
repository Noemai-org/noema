{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/recovery-request.v1.json",
  "title": "Recovery request",
  "description": "PERD REQ-VER-003 and DEC-2026-10-18. Every verdict other than ACHIEVED creates one, and so does a voided grant, addressed to Trust. verdict_id is required unless the trigger is a voided grant; then grant_id is required and verdict_id must be absent (exactly one of the two). Trust evaluates it as a fresh evaluation; neither Execution nor Outcome may start a write (INV-15, REQ-RCV-001). 'reason' is an upper-case code such as POSTCONDITION_UNVERIFIED or POLICY_SUPERSEDED; no value set is defined, so only the shape is fixed.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SchemaVersion"
    },
    "tenant_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
    },
    "correlation_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/CorrelationId"
    },
    "recovery_request_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/RecoveryRequestId"
    },
    "verdict_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/VerdictId"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/EvidenceId"
      },
      "uniqueItems": true
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Timestamp"
    },
    "grant_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/GrantId"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "correlation_id",
    "recovery_request_id",
    "reason",
    "evidence_refs",
    "attempt_count",
    "created_at"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "description": "Trigger is a verdict other than ACHIEVED: verdict_id required, grant_id absent.",
      "required": [
        "verdict_id"
      ],
      "not": {
        "required": [
          "grant_id"
        ]
      }
    },
    {
      "description": "Trigger is a voided grant: grant_id required, verdict_id absent.",
      "required": [
        "grant_id"
      ],
      "not": {
        "required": [
          "verdict_id"
        ]
      }
    }
  ]
}
