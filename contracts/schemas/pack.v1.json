{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/pack.v1.json",
  "title": "Vertical pack",
  "description": "SoT §15.5: everything Noema needs to serve one vertical, and no code. Loaded as data, never imported (SoT §51). Cross-references (every ID used exists; risk against consequence; predicates type-check) are checked by packcheck (PCK-02). Not defined here and left open: lexicon and explanation-template content, and benchmark seed cases.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SchemaVersion"
    },
    "pack_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Vertical"
    },
    "pack_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/Semver"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tenant_zone": {
      "description": "A647, A650 (interim; REQ-DATA-002): the tenant time zone as an IANA name, e.g. Africa/Lagos for the synthetic tenant. Optional. Every instant is stored in UTC; this is the zone a tenant-local date or window is read in. packcheck refuses a name the tz database does not know.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$"
    },
    "intent_nodes": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/intent-node.v1.json"
      },
      "minItems": 1
    },
    "trust_profiles": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/trust-profile.v1.json"
      },
      "minItems": 1
    },
    "outcome_definitions": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/outcome-definition.v1.json"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/capability-descriptor.v2.json"
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/evidence-source.v1.json"
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PackId"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.noema.invalid/policy-rule.v1.json"
          }
        }
      },
      "required": [
        "policy_id",
        "version",
        "rules"
      ],
      "additionalProperties": false
    },
    "clocks": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/clock.v1.json"
      }
    },
    "reason_catalogue": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/reason-catalogue-entry.v1.json"
      }
    },
    "case_reasons": {
      "description": "A369 (interim, relayed): the catalogue of reason codes a case may be opened with. A graph param of kind map may name only these codes (checked by packcheck). Optional; absent means no case reason.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    "action_graph_files": {
      "description": "Graph files relative to the pack file's folder, each an action-graph.v2.json document (T2; v2 since PCK-04). The fintech graphs live in packs/fintech/graph/.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*\\.json$"
      },
      "uniqueItems": true
    },
    "routing_allowlist": {
      "description": "The only queue IDs ROUTE_TO_INTERNAL_OWNER accepts (REQ-AG-002). Free-form destinations are not representable.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "handoff_routes": {
      "description": "A531 (interim, relayed): which core reason code goes to a handoff, to which queue, for which intent nodes. The queue is one of `routing_allowlist` (checked by packcheck; a free-form destination is not representable, REQ-AG-002). `intent_nodes` absent means every node. A reason code is routed at most once (checked by packcheck). Optional; absent means no handoff is routed. The pack declares the route and holds no behaviour: Trust asks whether a reason is routed and the orchestrator raises the alert.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "reason_code": {
            "$ref": "https://contracts.noema.invalid/enums.v1.json#/$defs/CoreReasonCode"
          },
          "owner_queue": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "intent_nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "reason_code",
          "owner_queue"
        ],
        "additionalProperties": false
      }
    },
    "evidence_descriptors": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.noema.invalid/evidence-descriptor.v1.json"
      }
    },
    "predicate_variables": {
      "description": "Typed names a predicate may use besides evidence entities, for example subject_resource or planned_queue. A dotted name (subject_resource.status) is one variable.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
      },
      "additionalProperties": {
        "$ref": "https://contracts.noema.invalid/evidence-descriptor.v1.json#/$defs/FieldType"
      }
    },
    "understanding": {
      "$ref": "#/$defs/Understanding"
    },
    "outcome_bindings": {
      "description": "A723 (interim, relayed; REQ-VER-001, REQ-EXE-006; INV-14, INV-24): per write capability, which outcome definition its result is verified against and where each predicate variable of that definition gets its value, so the core holds no capability or variable name (the Outcome request builder reads this, A692 step_params). `variables` maps a predicate variable (one of `predicate_variables` that the outcome's success predicate reads) to its source: `PLAN_PARAM:<param>` (one param of the executed plan step, an input of the capability, carried by the receipt's step_params), `INTENT_ID` (the plan's intent) or `SUBJECT` (the subject of the intent, its `subject_slot`). `retry_safety` repeats the capability's own (packcheck checks they are equal). Optional and additive (A698): absent means no capability has a binding. A capability is bound at most once, and only a write the pack declares and does not prohibit (all checked by packcheck). SYNTHETIC in the fintech pack.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/OutcomeBinding"
      }
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "name",
    "intent_nodes",
    "trust_profiles",
    "outcome_definitions",
    "capabilities",
    "evidence_sources",
    "policy",
    "clocks",
    "reason_catalogue"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExactNumber": {
      "description": "A non-negative decimal or fraction written as a string, such as \"0.35\" or \"7/20\". Never a JSON number: a float would let the same file mean different things on different machines (INV-21; the model service's ranking reader refuses floats).",
      "type": "string",
      "pattern": "^(?:[0-9]{1,18}(?:\\.[0-9]{1,18})?|[0-9]{1,18}/[1-9][0-9]{0,17})$"
    },
    "Understanding": {
      "description": "Pipeline and ranking data the model service reads (PERD REQ-AMB-002, REQ-AMB-003, REQ-INT-005, §20.3; DEC-2026-10-20 D3 and D5). Every number is a value the PERD already gives, labelled in packs/fintech/understanding.md; none is tuned here (AGENT-16). The margin and the limit of four live in the intent node's disambiguation, not here.",
      "type": "object",
      "properties": {
        "ranking": {
          "type": "object",
          "properties": {
            "weights": {
              "description": "Per feature, exactly 1 together (checked by packcheck).",
              "type": "object",
              "properties": {
                "amount": {
                  "$ref": "#/$defs/ExactNumber"
                },
                "recipient": {
                  "$ref": "#/$defs/ExactNumber"
                },
                "temporal": {
                  "$ref": "#/$defs/ExactNumber"
                },
                "relationship": {
                  "$ref": "#/$defs/ExactNumber"
                },
                "type_direction": {
                  "$ref": "#/$defs/ExactNumber"
                }
              },
              "required": [
                "amount",
                "recipient",
                "temporal",
                "relationship",
                "type_direction"
              ],
              "additionalProperties": false
            },
            "absolute_floor": {
              "$ref": "#/$defs/ExactNumber"
            },
            "max_raw_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "amount_tolerance_ratio": {
              "$ref": "#/$defs/ExactNumber"
            },
            "time_tolerance_seconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "weights",
            "absolute_floor",
            "max_raw_candidates",
            "amount_tolerance_ratio",
            "time_tolerance_seconds"
          ],
          "additionalProperties": false
        },
        "proposable_flags": {
          "description": "Ambiguity flags the model may propose, each with the yes-or-no question put to it (a prompt to a model, never customer copy).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "flag": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "flag",
              "question"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "material_flags": {
          "description": "Flags that are always material (PERD §20.3, the rows marked Yes).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "intent_unclear_flag": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "out_of_scope_flag": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "state_flags": {
          "description": "The flag each non-resolving ranking state raises.",
          "type": "object",
          "properties": {
            "NO_CANDIDATES": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "AMBIGUOUS": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "TOO_MANY_CANDIDATES": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "NO_CANDIDATES",
            "AMBIGUOUS",
            "TOO_MANY_CANDIDATES"
          ],
          "additionalProperties": false
        },
        "slot_gates": {
          "description": "Optional. The optional closed-vocabulary slots the model service asks first as one yes/no gate, each with the threshold, in integer basis points, at which the gate's yes counts (UND-18; ruling A603, interim). The slot is picked only when the gate passes, and then with no abstention; a doubt leaves the slot absent. The value is a Founder decision, never an agent's (AGENT-16). Which slots may be gated is packcheck's rule: optional, with a closed list of values, named once.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "assertion_threshold_bp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "slot",
              "assertion_threshold_bp"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ranking",
        "proposable_flags",
        "locales",
        "material_flags",
        "intent_unclear_flag",
        "out_of_scope_flag",
        "state_flags"
      ],
      "additionalProperties": false
    },
    "OutcomeBinding": {
      "type": "object",
      "properties": {
        "capability_id": {
          "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PackId"
        },
        "outcome_id": {
          "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PackId"
        },
        "variables": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(INTENT_ID|SUBJECT|PLAN_PARAM:[a-z][a-z0-9_]*)$"
          }
        },
        "retry_safety": {
          "$ref": "https://contracts.noema.invalid/enums.v1.json#/$defs/RetrySafety"
        }
      },
      "required": [
        "capability_id",
        "outcome_id",
        "variables",
        "retry_safety"
      ],
      "additionalProperties": false
    }
  }
}
