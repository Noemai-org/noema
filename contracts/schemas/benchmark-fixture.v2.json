{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/benchmark-fixture.v2.json",
  "title": "Benchmark fixture (v2, DRAFT)",
  "description": "DRAFT, with benchmark-case.v2 (noema#260; ruling A6, 8 Nov 2026: a minimal two-tenant synthetic fixture so X6 and the cross-tenant gate have real cases). v1 is not edited (AGENT-15). v2 adds `tenants` (each with leak-scan `markers`), `subject_tenant` (the tenant the principal acts for) and a `tenant_id` on every principal, beneficiary, transaction and case. A cross-tenant case names an object whose `tenant_id` is not the subject tenant. `tenant_id` is the shared `TenantId` of common.v1 (`ten_...`). Cross-field rules a JSON Schema cannot state, checked by `benchmark/fixtures/tenant_rules.py` (the fixture loader will call it before loading and load one slice per tenant, R3; that is a follow-up on the Integration Lead's side, so these rules are not enforced at load today): (1) every `tenant_id` names a listed tenant and `subject_tenant` is listed; (2) a transaction's `owner` and `beneficiary` and a case's `transaction` are in the SAME tenant as the object; (3) a `ref` or id is unique in the whole fixture, not per tenant; (4) a marker appears only in strings of its own tenant, including `enterprise_strings`, no marker is shared, and no marker contains another tenant's marker; (5) an `enterprise_strings` target takes the tenant of the object it names. Markers are SYNTHETIC strings of at least 8 characters that are valid for nothing; they are matched, case-insensitively (`tenant_rules` compares them casefolded), by the X6 cross-tenant scan, which is not built (`tools/ci/leakscan.py` detects secret-shaped strings and does not consume `markers`); they are never shown to an arm. The known facts of one benchmark scenario (PERD §48.2 `known_facts_fixture`; SoT §38.1 'the known facts'): who the principals are, their beneficiaries, the transactions and what each source says about them, and the cases that already exist. The runner loads it into the synthetic enterprise through the fixture loader; how a field maps to a Tushe call is the adapter task's, not this file's. The fixture holds scenario facts, never ground truth about what Noema should do: that is the oracle. Money is integer minor units with a currency (DEC-2026-10-16 M1). Every name, account and amount is made up. SYNTHETIC (AGENT-25).",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^fx_[a-z0-9_]{1,80}$",
      "maxLength": 128
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principal_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PrincipalId"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SlotName"
            },
            "uniqueItems": true,
            "maxItems": 1000
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "tenant_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
          }
        },
        "required": [
          "principal_id",
          "roles",
          "display_name",
          "tenant_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "beneficiary_id": {
            "type": "string",
            "pattern": "^ben_[0-9]{4}$",
            "maxLength": 128
          },
          "owner": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PrincipalId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "uniqueItems": true,
            "maxItems": 1000
          },
          "account_last4": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "maxLength": 4
          },
          "tenant_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
          }
        },
        "required": [
          "beneficiary_id",
          "owner",
          "name",
          "aliases",
          "account_last4",
          "tenant_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/ResourceRef"
          },
          "owner": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/PrincipalId"
          },
          "beneficiary": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^ben_[0-9]{4}$",
            "maxLength": 128
          },
          "direction": {
            "type": "string",
            "enum": [
              "OUTGOING",
              "INCOMING"
            ]
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "maxLength": 3
          },
          "age_minutes": {
            "description": "How long before the case starts the transaction happened.",
            "type": "integer",
            "minimum": 0,
            "maximum": 525600
          },
          "ledger": {
            "type": "string",
            "enum": [
              "POSTED",
              "NOT_POSTED",
              "REVERSED",
              "UNAVAILABLE"
            ]
          },
          "switch": {
            "type": "string",
            "enum": [
              "APPROVED",
              "DECLINED",
              "TIMED_OUT",
              "PENDING",
              "UNAVAILABLE"
            ]
          },
          "destination": {
            "type": "string",
            "enum": [
              "CREDITED",
              "NOT_CREDITED",
              "PENDING",
              "UNAVAILABLE"
            ]
          },
          "settlement": {
            "type": "string",
            "enum": [
              "SETTLED",
              "PENDING",
              "REVERSAL_PENDING",
              "REVERSED",
              "UNAVAILABLE"
            ]
          },
          "tenant_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
          }
        },
        "required": [
          "ref",
          "owner",
          "beneficiary",
          "direction",
          "amount_minor",
          "currency",
          "age_minutes",
          "ledger",
          "switch",
          "destination",
          "settlement",
          "tenant_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "cases": {
      "description": "Cases that already exist in the case system when the scenario starts.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/ResourceRef"
          },
          "transaction": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/ResourceRef"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "ROUTED",
              "CLOSED"
            ]
          },
          "owner_queue": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 128
          },
          "tenant_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
          }
        },
        "required": [
          "ref",
          "transaction",
          "status",
          "owner_queue",
          "tenant_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "enterprise_strings": {
      "description": "Free text that lives in enterprise data: narrations, notes. It is data, never an instruction (AGENT-09).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/ResourceRef"
          },
          "field": {
            "type": "string",
            "enum": [
              "narration",
              "case_note",
              "beneficiary_name"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "target",
          "field",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "markers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 80
            },
            "maxItems": 1000
          }
        },
        "required": [
          "tenant_id",
          "display_name",
          "markers"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "subject_tenant": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/TenantId"
    }
  },
  "required": [
    "fixture_id",
    "synthetic",
    "principals",
    "beneficiaries",
    "transactions",
    "cases",
    "enterprise_strings",
    "tenants",
    "subject_tenant"
  ],
  "additionalProperties": false
}
