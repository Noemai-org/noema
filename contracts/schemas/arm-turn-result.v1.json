{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/arm-turn-result.v1.json",
  "title": "Arm turn result",
  "description": "The result file of one arm turn (A118, Draft until committed). `diagnostic` is true exactly when `mode` is FORCED_SCHEMA_DIAGNOSTIC: a forced-schema result is never a comparison result. Only status OK carries tool calls or text; every other status carries neither. Cost is in micro-units (USD) and counts toward the live-run cap. SYNTHETIC only; unknown fields are rejected.",
  "type": "object",
  "required": [
    "schema_version",
    "turn_id",
    "correlation_id",
    "label",
    "mode",
    "diagnostic",
    "status",
    "provider_id",
    "model_version",
    "tool_calls",
    "text",
    "usage",
    "latency_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/SchemaVersion"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^trn_[0-9A-Za-z]{2,32}$"
    },
    "correlation_id": {
      "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/CorrelationId"
    },
    "label": {
      "const": "SYNTHETIC"
    },
    "mode": {
      "enum": [
        "NATIVE_TOOL_CALLING",
        "FORCED_SCHEMA_DIAGNOSTIC"
      ]
    },
    "diagnostic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "OK",
        "REFUSED_UNQUALIFIED",
        "PROVIDER_ERROR",
        "TIMEOUT",
        "MALFORMED_OUTPUT"
      ]
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tool_calls": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "call_id",
          "name",
          "arguments"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string",
            "pattern": "^call_[0-9A-Za-z]{1,32}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,63}$"
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_micros"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micros": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "FORCED_SCHEMA_DIAGNOSTIC"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostic": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "diagnostic": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "status": {
              "const": "OK"
            }
          }
        }
      },
      "then": {
        "properties": {
          "tool_calls": {
            "maxItems": 0
          },
          "text": {
            "type": "null"
          }
        }
      }
    }
  ]
}
