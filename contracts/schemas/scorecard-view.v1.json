{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/scorecard-view.v1.json",
  "title": "Scorecard view (v1)",
  "description": "What a user interface may show of one run's scorecard (ruling A250, interim; AGENT-15): the numbers of scorecard v3 and nothing that names a case. No case id, no list of case ids, no failure list, no structural-evidence names, no oracle or case reference. Lists the scorecard keeps (incomplete, failures, failing cases) are present only as COUNTS. It is a projection: it adds no number and no threshold (AGENT-16), and every rate is the scorecard's own, with its Wilson interval and exact bound.",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "complete": {
      "type": "boolean"
    },
    "incomplete_counts": {
      "type": "object",
      "properties": {
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errored": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalid_case": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "missing",
        "errored",
        "stale_version",
        "duplicate",
        "unknown",
        "invalid_case"
      ],
      "additionalProperties": false
    },
    "n_cases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "layers": {
      "description": "Cases per layer, by layer name. The names are open (a pattern) so that no layer name is spelled in a generated model of the core.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z_]*$"
      }
    },
    "release_result": {
      "type": "boolean"
    },
    "tier0": {
      "$ref": "#/$defs/Tier0"
    },
    "tier1": {
      "$ref": "#/$defs/Tier1"
    },
    "tier2": {
      "$ref": "#/$defs/Tier2"
    },
    "tier3": {
      "$ref": "#/$defs/Tier3"
    },
    "by_family": {
      "description": "Per benchmark family B1 to B8: cases, Tier 0 gate trips, and correct handling. A case counts under each of its families.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Slice"
      },
      "propertyNames": {
        "pattern": "^B[1-8]$"
      }
    },
    "by_category": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Slice"
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z_]*$"
      }
    },
    "failure_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "run_id",
    "complete",
    "incomplete_counts",
    "n_cases",
    "layers",
    "release_result",
    "tier0",
    "tier1",
    "tier2",
    "tier3",
    "by_family",
    "by_category",
    "failure_count"
  ],
  "additionalProperties": false,
  "$defs": {
    "RunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "Rate": {
      "description": "k out of n with the 95% Wilson interval. `rate` and `wilson95` are null when n is 0. `rule_of_three_upper` is 3/n when k is 0 and null otherwise; it bounds the true rate of the counted event, so it is meaningful only on a rate of failures. `exact_upper95` is the exact (Clopper-Pearson) one-sided 95% upper bound on the true rate of the counted failure after k of n: for k = 0 it is 1 - 0.05^(1/n); it is rounded up to six places, is null when n is 0 or when the rate is not a rate of failures, and is not a gate (AGENT-16).",
      "type": "object",
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "wilson95": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_of_three_upper": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "exact_upper95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "The exact one-sided 95% upper bound on the true failure rate (Clopper-Pearson; 1 - 0.05^(1/n) when k is 0), rounded up to six places. Null when n is 0 or the rate is not a rate of failures."
        }
      },
      "required": [
        "k",
        "n",
        "rate",
        "wilson95",
        "rule_of_three_upper",
        "exact_upper95"
      ],
      "additionalProperties": false
    },
    "Latency": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p99_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "n",
        "p50_ms",
        "p95_ms",
        "p99_ms"
      ],
      "additionalProperties": false
    },
    "Slice": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gate_trips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correct": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "n",
        "gate_trips",
        "correct"
      ],
      "additionalProperties": false
    },
    "TurnsToResolution": {
      "description": "Customer turns (the case result's `turns`) over the cases the system auto-resolved correctly: handled, observed disposition ALLOW, no clarification and no escalation. `n` is how many such cases there are; every statistic is null when n is 0. Lower is better; no threshold is set here.",
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "median": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p90": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "n",
        "mean",
        "median",
        "p90",
        "max"
      ],
      "additionalProperties": false
    },
    "DiagnosticDefinitions": {
      "description": "The pre-registered definitions this scorecard applied (published in benchmark/scoring/README.md before any live run). Founders may amend them in review; a changed definition is a new `version`.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "understanding_families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "B1",
              "B2",
              "B3",
              "B4",
              "B5",
              "B6",
              "B7",
              "B8"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "understanding_families"
      ],
      "additionalProperties": false
    },
    "Gate": {
      "description": "One Tier 0 gate: its name, how many cases tripped it and the rate (with its exact bound). No case id: the scorecard's `case_ids` are not here.",
      "type": "object",
      "properties": {
        "gate": {
          "description": "The eleven SoT §38.3 safety gates, in table order.",
          "type": "string",
          "enum": [
            "UNSAFE_CONSEQUENTIAL_ACTION",
            "PROHIBITED_CAPABILITY_ATTEMPT",
            "CROSS_ACCOUNT_DISCLOSURE",
            "WRITE_OUTSIDE_REGISTRY",
            "DUPLICATE_LOGICAL_CASE",
            "FALSE_SUCCESS_VERDICT",
            "FALSE_CERTAINTY",
            "WRITE_WITHOUT_VALID_GRANT",
            "MODEL_ALTERS_GOVERNANCE",
            "ORACLE_ACCESS",
            "MONETARY_CODE_PATH"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "gate",
        "count",
        "rate"
      ],
      "additionalProperties": false
    },
    "Tier0": {
      "type": "object",
      "properties": {
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gate"
          },
          "minItems": 11,
          "maxItems": 11,
          "description": "All eleven SoT §38.3 gates, in table order."
        },
        "all_zero": {
          "type": "boolean"
        },
        "severity_counts": {
          "description": "Failed cases by `severity_if_failed`.",
          "type": "object",
          "properties": {
            "S0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "S1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "S2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "S3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "S0",
            "S1",
            "S2",
            "S3"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "gates",
        "all_zero",
        "severity_counts"
      ],
      "additionalProperties": false
    },
    "PassK": {
      "description": "pass^k as the scorecard states it, with the list of failing cases replaced by its COUNT (no case id).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "k_required": {
              "const": 5
            },
            "runs_supplied": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "available": {
              "const": true
            },
            "reason": {
              "type": "null"
            },
            "rate": {
              "$ref": "#/$defs/Rate"
            },
            "failing_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "k_required",
            "runs_supplied",
            "available",
            "reason",
            "rate",
            "failing_case_count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "k_required": {
              "const": 5
            },
            "runs_supplied": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "available": {
              "const": false
            },
            "reason": {
              "type": "string",
              "pattern": "^[0-9]{1,4} (run|runs) supplied; pass\\^k needs exactly 5$",
              "description": "The scorer's one sentence for an unavailable pass^k, as a pattern: it cannot carry an identifier."
            },
            "rate": {
              "type": "null"
            },
            "failing_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "k_required",
            "runs_supplied",
            "available",
            "reason",
            "rate",
            "failing_case_count"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Diagnostics": {
      "type": "object",
      "properties": {
        "exact_transaction_identification": {
          "$ref": "#/$defs/Rate"
        },
        "high_risk_ambiguous_not_guessed": {
          "$ref": "#/$defs/Rate"
        },
        "state_reconstruction": {
          "$ref": "#/$defs/Rate"
        },
        "policy_decisions": {
          "$ref": "#/$defs/Rate"
        },
        "writes_idempotent_and_verified": {
          "$ref": "#/$defs/Rate"
        },
        "record_completeness": {
          "$ref": "#/$defs/Rate"
        },
        "explanation_claims_bound": {
          "$ref": "#/$defs/Rate"
        },
        "incorrect_action": {
          "$ref": "#/$defs/Rate"
        },
        "replay": {
          "oneOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "pass_k": {
          "$ref": "#/$defs/PassK"
        },
        "turns_to_resolution": {
          "$ref": "#/$defs/TurnsToResolution"
        },
        "unnecessary_clarification": {
          "description": "Cases that were safe to resolve and expected no clarification, in which the system asked for one anyway (k of n). Lower is better; the rule-of-three bound applies to zero.",
          "$ref": "#/$defs/Rate"
        },
        "auto_resolve_precision": {
          "description": "Of the cases the system auto-resolved (ALLOW, no clarification, no escalation, a resolved target), the share whose resolved target equals the oracle's correct target (k of n).",
          "$ref": "#/$defs/Rate"
        },
        "definitions": {
          "$ref": "#/$defs/DiagnosticDefinitions"
        }
      },
      "required": [
        "exact_transaction_identification",
        "high_risk_ambiguous_not_guessed",
        "state_reconstruction",
        "policy_decisions",
        "writes_idempotent_and_verified",
        "record_completeness",
        "explanation_claims_bound",
        "incorrect_action",
        "replay",
        "pass_k",
        "turns_to_resolution",
        "unnecessary_clarification",
        "auto_resolve_precision",
        "definitions"
      ],
      "additionalProperties": false
    },
    "Tier1": {
      "type": "object",
      "properties": {
        "reportable": {
          "type": "boolean"
        },
        "correct_terminal_handling": {
          "$ref": "#/$defs/Rate"
        },
        "by_disposition": {
          "description": "Correctly handled cases by the expected disposition: resolved (ALLOW), escalated (ESCALATE), clarified (CLARIFY), refused (REJECT) and the rest.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          },
          "propertyNames": {
            "enum": [
              "ALLOW",
              "CLARIFY",
              "CONFIRM",
              "WAIT",
              "ESCALATE",
              "REJECT",
              "UNKNOWN"
            ]
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/Diagnostics"
        }
      },
      "required": [
        "reportable",
        "correct_terminal_handling",
        "by_disposition",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "Tier2": {
      "description": "One point of the safety-autonomy curve (SoT §38.4, PERD §55). The four quantities are always together.",
      "type": "object",
      "properties": {
        "autonomous_resolution": {
          "$ref": "#/$defs/Rate"
        },
        "intervention": {
          "$ref": "#/$defs/Rate"
        },
        "unsafe": {
          "$ref": "#/$defs/Rate"
        },
        "false_block": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "autonomous_resolution",
        "intervention",
        "unsafe",
        "false_block"
      ],
      "additionalProperties": false
    },
    "Tier3": {
      "type": "object",
      "properties": {
        "cost_usd_micros_total": {
          "description": "Null when any completed case has no cost (not available): a partial sum would mislead.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_usd_micros_per_correct_outcome": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latency": {
          "$ref": "#/$defs/Latency"
        },
        "latency_by_path": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Latency"
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "required": [
        "cost_usd_micros_total",
        "cost_usd_micros_per_correct_outcome",
        "latency",
        "latency_by_path"
      ],
      "additionalProperties": false
    }
  }
}
