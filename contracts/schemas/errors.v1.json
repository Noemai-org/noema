{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.noema.invalid/errors.v1.json",
  "title": "Error envelope and catalogue",
  "description": "PERD §39.1 and REQ-API-002: the error shape everywhere, with the code catalogue. Messages are safe text: no PII, stack trace, policy threshold or another principal's data, and no run of five or more digits. Not-found and not-authorised are one code (NOT_FOUND_OR_NOT_AUTHORIZED) so they cannot be told apart. Retryability is a property of the code, never inferred from an HTTP status, and a retryable transport error never overrides a capability's retry-safety class: a write is retried only under a new grant. Which codes are retryable is [REC] (PERD gives the code list, not the flags).",
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "SCHEMA_INVALID",
        "UNKNOWN_ENUM_VALUE",
        "SESSION_INVALID",
        "UNAUTHENTICATED",
        "NOT_FOUND_OR_NOT_AUTHORIZED",
        "TENANT_SCOPE_MISMATCH",
        "REQUEST_ID_REUSED",
        "AMBIGUOUS_TARGET",
        "STALE_CANDIDATE_SET",
        "EVIDENCE_UNAVAILABLE",
        "EVIDENCE_STALE",
        "CONTRADICTORY_STATE",
        "POLICY_STALE",
        "GRANT_INVALID",
        "GRANT_EXPIRED",
        "GRANT_ALREADY_SPENT",
        "CONFIRMATION_EXPIRED",
        "CONFIRMATION_BINDING_MISMATCH",
        "APPROVER_NOT_ELIGIBLE",
        "CAPABILITY_PROHIBITED",
        "CAPABILITY_NOT_REGISTERED",
        "IDEMPOTENCY_CONFLICT",
        "REJECTED_STALE_VERSION",
        "TARGET_RATE_LIMITED",
        "TARGET_TIMEOUT",
        "OUTCOME_UNKNOWN",
        "POSTCONDITION_UNVERIFIED",
        "RECORD_INTEGRITY_FAILURE",
        "WRITES_DISABLED",
        "PROVIDER_UNAVAILABLE",
        "DEPENDENCY_UNAVAILABLE",
        "CALLBACK_DELIVERY_FAILED",
        "INTERNAL_SAFETY_BLOCK"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?![\\s\\S]*[0-9]{5})[\\s\\S]*$"
        },
        "retryable": {
          "type": "boolean"
        },
        "correlation_id": {
          "$ref": "https://contracts.noema.invalid/common.v1.json#/$defs/CorrelationId"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "issue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^(?![\\s\\S]*[0-9]{5})[\\s\\S]*$"
              }
            },
            "required": [
              "field",
              "issue"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "correlation_id"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "code": {
            "enum": [
              "EVIDENCE_UNAVAILABLE",
              "TARGET_RATE_LIMITED",
              "TARGET_TIMEOUT",
              "PROVIDER_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "CALLBACK_DELIVERY_FAILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/ErrorEnvelope"
}
