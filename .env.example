# Names only. Never put a value here. Local secrets are file-mounted from a git-ignored path (OD-P-22).
# GitHub Actions secret, read-only access to Noemai-org/docs, used only by .github/workflows/docs-drift.yml
DOCS_READ_TOKEN=
NOEMA_CORE_ADDR=
NOEMA_MODEL_ADDR=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD_FILE=

# Secrets held in GitHub Environments (docs/vendors/README.md in Noemai-org/docs is the register). Names only.
# A name ending in * covers every name with that prefix. tools/ci/check_secret_refs.py fails a workflow that reads a secret not listed here.
NOEMA_DB_PASSWORD_FILE=
# model-ci and bench
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
AETHEX_API_KEY=
INDIGENIUS_API_KEY=
# bench only (decision models: no adapter is built unless the bake-off needs one)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
TYPESAFE_API_KEY=
# core-ci
TUSHE_BASE_URL=
TUSHE_INTEGRATION_CLIENT_ID=
TUSHE_INTEGRATION_CLIENT_SECRET=
# the public webhook relay's own Environment
WEBHOOK_RELAY_SIGNING_SECRET=
