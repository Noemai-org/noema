{
  "breaker": {
    "cooldown_ms": 30000,
    "failure_threshold": 5
  },
  "data_limits": {
    "default_max_chars": 256,
    "overrides": {
      "prior_turn": 2000,
      "utterance": 2000
    }
  },
  "masking": {
    "account_run_min_digits": 8
  },
  "providers": {
    "openai_luna": {
      "credential_env": "OPENAI_API_KEY",
      "endpoint": "https://api.openai.com",
      "kind": "openai_responses",
      "max_output_tokens": 4000,
      "max_response_bytes": 1000000,
      "model_version": "gpt-6-luna",
      "rate": {
        "as_of": "2026-10-27",
        "currency": "USD",
        "input_micro_per_mtok": 100000,
        "output_micro_per_mtok": 500000
      },
      "reasoning_effort": "medium",
      "timeout_ms": 30000
    }
  },
  "routes": {
    "decide.ambiguity_flag": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "decide.answer_binding": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "decide.enumerated_slot": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "decide.instruction_likeness": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "decide.intent_node_classification": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "decide.locale_detection": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    },
    "slot_values": {
      "by_locale": {},
      "default": [
        "openai_luna"
      ]
    }
  }
}
