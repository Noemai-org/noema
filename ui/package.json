{
  "name": "noema-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Noema UI shell. No features; the UI shows only state the backend has verified (AGENTS.md section 7).",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
